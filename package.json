{
  "name": "ducati-leads",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:build": "node scripts/serve-build.mjs",
    "check": "astro check",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:smoke": "node --env-file=.env scripts/smoke-test.mjs",
    "inspect": "node scripts/inspect-build.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "db:seed": "node --env-file=.env scripts/seed-leads.mjs",
    "db:studio": "drizzle-kit studio",
    "bikes:images": "node scripts/fetch-bike-images.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/vercel": "11.0.10",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@neondatabase/serverless": "1.1.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.3",
    "drizzle-orm": "0.45.2",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/mcp": "^0.0.82",
    "dotenv": "^18.0.1",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3",
    "vitest": "^5.0.1"
  }
}
