---
import BikeCard from './BikeCard.astro';
import { bikes, FAMILIES } from '../data/bikes';

/**
 * Catálogo con filtro por familia.
 *
 * El filtro son radios nativos y CSS `:has()`: no hay JavaScript, funciona
 * con teclado y lector de pantalla, y no hay nada que hidratar. Si un
 * navegador no soporta `:has()`, simplemente se ven todos los modelos.
 */

const options = ['Todas', ...FAMILIES] as const;

const slug = (value: string) =>
  value.toLowerCase().replace(/\s+/g, '-');
---

<section id="modelos" class="catalog">
  <div class="container-site">
    <header class="catalog-header">
      <h2>La gama completa</h2>
      <p>
        Veintidós modelos oficiales para Argentina, con potencia, torque, peso
        y precio de referencia. Filtrá por familia y pedí la cotización del que
        te interese.
      </p>
    </header>

    <fieldset class="filters">
      <legend class="sr-only">Filtrar modelos por familia</legend>
      {
        options.map((option, i) => (
          <>
            <input
              type="radio"
              name="familia"
              id={`familia-${slug(option)}`}
              value={option}
              checked={i === 0}
              class="filter-input"
            />
            <label for={`familia-${slug(option)}`} class="filter-label">
              {option}
            </label>
          </>
        ))
      }
    </fieldset>

    <ul class="grid">
      {
        bikes.map((bike, i) => (
          <li data-family={bike.family}>
            <BikeCard bike={bike} eager={i < 4} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .catalog {
    padding-block: 64px;
    background: var(--color-neutral-50);
  }

  .catalog-header h2 {
    font-size: var(--text-heading-lg);
  }

  .catalog-header p {
    max-width: 62ch;
    margin-top: 12px;
    color: var(--color-neutral-800);
    line-height: 1.55;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* Barra de filtros: scroll horizontal en mobile, según DESIGN.md. */
  .filters {
    display: flex;
    gap: 8px;
    margin-top: 32px;
    padding: 0 0 4px;
    border: 0;
    overflow-x: auto;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
    /* Un <fieldset> trae min-width:min-content del navegador y no achica por
       debajo de su contenido. Sin esto, los ocho filtros estiran la página a
       ~990px en mobile y aparece scroll horizontal en todo el sitio en vez
       de dentro de la barra. */
    min-width: 0;
  }

  .filter-input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .filter-label {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    background: var(--color-neutral-0);
    border: 1px solid var(--color-neutral-300);
    border-radius: var(--radius-sm);
    font-family: var(--font-display);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-neutral-800);
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 120ms ease, border-color 120ms ease;
  }

  .filter-label:hover {
    border-color: var(--color-neutral-950);
  }

  .filter-input:checked + .filter-label {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-neutral-0);
  }

  /* El radio está oculto, así que el foco tiene que verse en la etiqueta. */
  .filter-input:focus-visible + .filter-label {
    outline: 2px solid var(--color-primary-light);
    outline-offset: 2px;
  }

  .grid {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: grid;
    gap: 16px;
    grid-template-columns: 1fr;
  }

  .grid > li {
    display: flex;
  }

  .grid > li > :global(*) {
    width: 100%;
  }

  /* Filtro por familia: una regla por opción. Cuando un radio está marcado,
     se ocultan los <li> que no son de esa familia. */
  .catalog:has(#familia-panigale:checked) .grid > li:not([data-family='Panigale']),
  .catalog:has(#familia-streetfighter:checked) .grid > li:not([data-family='Streetfighter']),
  .catalog:has(#familia-monster:checked) .grid > li:not([data-family='Monster']),
  .catalog:has(#familia-multistrada:checked) .grid > li:not([data-family='Multistrada']),
  .catalog:has(#familia-diavel:checked) .grid > li:not([data-family='Diavel']),
  .catalog:has(#familia-hypermotard:checked) .grid > li:not([data-family='Hypermotard']),
  .catalog:has(#familia-desert-x:checked) .grid > li:not([data-family='Desert X']),
  .catalog:has(#familia-scrambler:checked) .grid > li:not([data-family='Scrambler']) {
    display: none;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  @media (min-width: 1024px) {
    .catalog {
      padding-block: 96px;
    }

    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1280px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
