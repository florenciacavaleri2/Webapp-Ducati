---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { formatPrice, type Bike } from '../data/bikes';

interface Props {
  bike: Bike;
  /** Las primeras tarjetas entran en pantalla: no conviene diferirlas. */
  eager?: boolean;
}

const { bike, eager = false } = Astro.props;

// Las fotos se bajan con `npm run bikes:images`, así que el nombre del archivo
// se deriva del slug y hay que resolverlo en tiempo de build.
const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/bikes/*.webp',
  { eager: true }
);
const image = images[`../assets/bikes/${bike.slug}.webp`]?.default;

if (!image) {
  throw new Error(
    `Falta la imagen de "${bike.slug}". Corré: npm run bikes:images`
  );
}

const price = formatPrice(bike);
const specs = [bike.power, bike.torque, bike.weight].filter(Boolean);
---

<article class="card" data-family={bike.family}>
  <div class="card-media">
    <Image
      src={image}
      alt={`Ducati ${bike.name}`}
      class="card-image"
      widths={[320, 480, 630]}
      sizes="(min-width: 1280px) 300px, (min-width: 768px) 45vw, 90vw"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </div>

  <div class="card-body">
    <p class="card-family">{bike.family}</p>
    <h3 class="card-name">{bike.name}</h3>

    {
      specs.length > 0 ? (
        <p class="card-specs tabular">{specs.join(' / ')}</p>
      ) : (
        <p class="card-specs card-specs-empty">{bike.segment}</p>
      )
    }

    <div class="card-footer">
      {
        price ? (
          <p class="card-price tabular">
            {price}
            {bike.priceNote && <span class="card-price-note">{bike.priceNote}</span>}
          </p>
        ) : (
          /* Un precio que no existe no debe pesar lo mismo que uno real, y en
             cuerpo de display se partía en dos líneas y desalineaba la fila. */
          <p class="card-price-tbd">Precio a consultar</p>
        )
      }
      {/* Sin JavaScript baja al formulario; con JavaScript además deja el
          modelo ya elegido en el select (ver LeadForm.astro). */}
      <a class="card-cta" href="#contacto" data-bike={bike.slug}>
        Consultar
      </a>
    </div>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--color-neutral-0);
    border: 1px solid var(--color-neutral-100);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .card-media {
    background: var(--color-neutral-50);
    /* Alto fijo para que todas las tarjetas se alineen aunque los nombres
       tengan distinto largo. */
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 160ms ease;
  }

  .card:hover .card-image {
    transform: scale(1.02);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 20px;
    border-top: 1px solid var(--color-neutral-100);
  }

  .card-family {
    font-family: var(--font-display);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-neutral-500);
  }

  .card-name {
    margin-top: 4px;
    font-size: var(--text-heading-sm);
    color: var(--color-neutral-950);
  }

  .card-specs {
    margin-top: 8px;
    font-size: var(--text-body-sm);
    color: var(--color-neutral-800);
  }

  .card-specs-empty {
    color: var(--color-neutral-500);
  }

  .card-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    /* Empuja precio y CTA al pie para que queden a la misma altura en toda
       la fila, sin importar cuánto texto tenga cada tarjeta. */
    margin-top: auto;
    padding-top: 20px;
  }

  .card-price {
    font-family: var(--font-display);
    font-size: var(--text-heading-md);
    font-weight: 600;
    color: var(--color-neutral-950);
    line-height: 1.1;
  }

  .card-price-tbd {
    font-size: var(--text-body-md);
    color: var(--color-neutral-500);
    line-height: 1.3;
  }

  .card-price-note {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: 400;
    color: var(--color-neutral-500);
    margin-top: 2px;
  }

  .card-cta {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-secondary);
    text-decoration: underline;
    text-underline-offset: 5px;
    padding-block: 10px;
  }

  .card-cta:hover {
    color: var(--color-secondary-dark);
  }

  @media (min-width: 768px) {
    .card-media {
      height: 230px;
    }
  }
</style>
