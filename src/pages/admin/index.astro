---
import { and, count, desc, eq, ilike, inArray, or, type SQL } from 'drizzle-orm';
import Admin from '../../layouts/Admin.astro';
import { getDb, leads, LEAD_STATUSES } from '../../db';
import { FAMILIES, bikes } from '../../data/bikes';
import { getCountry } from '../../data/countries';

export const prerender = false;

const PAGE_SIZE = 25;

const params = Astro.url.searchParams;

const q = (params.get('q') ?? '').trim().slice(0, 100);
const status = params.get('status') ?? '';
const family = params.get('family') ?? '';
const page = Math.max(1, Number(params.get('page') ?? '1') || 1);

// Los filtros vienen de la URL, así que solo aceptamos valores del catálogo:
// nada de lo que llegue por query string entra directo en la consulta.
const activeStatus = (LEAD_STATUSES as readonly string[]).includes(status)
  ? status
  : '';
const activeFamily = (FAMILIES as readonly string[]).includes(family) ? family : '';

const conditions: SQL[] = [];

if (q) {
  const pattern = `%${q}%`;
  const search = or(ilike(leads.fullName, pattern), ilike(leads.email, pattern));
  if (search) conditions.push(search);
}

if (activeStatus) {
  conditions.push(eq(leads.status, activeStatus));
}

if (activeFamily) {
  const slugs = bikes.filter((b) => b.family === activeFamily).map((b) => b.slug);
  conditions.push(inArray(leads.bikeSlug, slugs));
}

const where = conditions.length > 0 ? and(...conditions) : undefined;

const db = await getDb();

const [{ total }] = await db
  .select({ total: count() })
  .from(leads)
  .where(where);

const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
const currentPage = Math.min(page, totalPages);

const rows = await db
  .select()
  .from(leads)
  .where(where)
  .orderBy(desc(leads.createdAt))
  .limit(PAGE_SIZE)
  .offset((currentPage - 1) * PAGE_SIZE);

// Conteo por estado para las pastillas de arriba, sin filtrar.
const statusRows = await db
  .select({ status: leads.status, total: count() })
  .from(leads)
  .groupBy(leads.status);

const totals = Object.fromEntries(statusRows.map((r) => [r.status, r.total]));
const grandTotal = statusRows.reduce((sum, r) => sum + r.total, 0);

/** Construye una URL conservando los filtros actuales. */
function urlWith(overrides: Record<string, string | number | undefined>) {
  const next = new URLSearchParams();
  if (q) next.set('q', q);
  if (activeStatus) next.set('status', activeStatus);
  if (activeFamily) next.set('family', activeFamily);
  for (const [key, value] of Object.entries(overrides)) {
    if (value === undefined || value === '') next.delete(key);
    else next.set(key, String(value));
  }
  const s = next.toString();
  return s ? `/admin?${s}` : '/admin';
}

const dateFormat = new Intl.DateTimeFormat('es-AR', {
  day: '2-digit',
  month: '2-digit',
  year: '2-digit',
  hour: '2-digit',
  minute: '2-digit',
});

const currentQuery = Astro.url.search;
---

<Admin title="Leads">
  <div class="head">
    <div>
      <h1>Leads</h1>
      <p class="head-sub">
        {grandTotal === 0
          ? 'Todavía no entró ninguna consulta.'
          : `${grandTotal} consultas en total.`}
      </p>
    </div>
    <a class="btn btn-secondary btn-sm" href={`/admin/export.csv${currentQuery}`}>
      Exportar CSV
    </a>
  </div>

  <div class="tallies">
    {
      LEAD_STATUSES.map((s) => (
        <a
          class="tally"
          href={urlWith({ status: activeStatus === s ? '' : s, page: undefined })}
          aria-current={activeStatus === s ? 'true' : undefined}
        >
          <span class="tally-count tabular">{totals[s] ?? 0}</span>
          <span class="tally-label">{s}</span>
        </a>
      ))
    }
  </div>

  <form method="GET" class="filters" role="search">
    <div class="filters-field">
      <label class="field-label" for="q">Buscar</label>
      <input
        class="field-input"
        type="search"
        id="q"
        name="q"
        value={q}
        placeholder="Nombre o email"
      />
    </div>

    <div class="filters-field">
      <label class="field-label" for="status">Estado</label>
      <select class="field-input" id="status" name="status">
        <option value="">Todos</option>
        {
          LEAD_STATUSES.map((s) => (
            <option value={s} selected={activeStatus === s}>
              {s}
            </option>
          ))
        }
      </select>
    </div>

    <div class="filters-field">
      <label class="field-label" for="family">Familia</label>
      <select class="field-input" id="family" name="family">
        <option value="">Todas</option>
        {
          FAMILIES.map((f) => (
            <option value={f} selected={activeFamily === f}>
              {f}
            </option>
          ))
        }
      </select>
    </div>

    <button type="submit" class="btn btn-primary btn-sm">Filtrar</button>
    {
      (q || activeStatus || activeFamily) && (
        <a class="filters-clear" href="/admin">
          Limpiar
        </a>
      )
    }
  </form>

  {
    rows.length === 0 ? (
      <p class="empty">
        {grandTotal === 0
          ? 'Cuando alguien complete el formulario de la web, su consulta aparece acá.'
          : 'Ningún lead coincide con estos filtros. Probá ampliar la búsqueda.'}
      </p>
    ) : (
      <>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">Fecha</th>
                <th scope="col">Nombre</th>
                <th scope="col">Email</th>
                <th scope="col">País</th>
                <th scope="col">Moto</th>
                <th scope="col">Estado</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((lead) => (
                <tr>
                  <td class="tabular nowrap">{dateFormat.format(lead.createdAt)}</td>
                  <td>{lead.fullName}</td>
                  <td>
                    <a href={`mailto:${lead.email}`}>{lead.email}</a>
                  </td>
                  <td>{getCountry(lead.country)?.name ?? lead.country}</td>
                  <td>{lead.bikeName}</td>
                  <td>
                    <form method="POST" action="/admin/status" class="status-form">
                      <input type="hidden" name="id" value={lead.id} />
                      <input type="hidden" name="back" value={currentQuery} />
                      <label class="sr-only" for={`status-${lead.id}`}>
                        Estado de {lead.fullName}
                      </label>
                      <select
                        class="status-select"
                        id={`status-${lead.id}`}
                        name="status"
                        data-autosubmit
                      >
                        {LEAD_STATUSES.map((s) => (
                          <option value={s} selected={lead.status === s}>
                            {s}
                          </option>
                        ))}
                      </select>
                      <button type="submit" class="status-apply">
                        Guardar
                      </button>
                    </form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {totalPages > 1 && (
          <nav class="pager" aria-label="Paginación">
            <a
              class="pager-link"
              href={urlWith({ page: currentPage - 1 })}
              aria-disabled={currentPage === 1 ? 'true' : undefined}
            >
              Anterior
            </a>
            <span class="tabular">
              Página {currentPage} de {totalPages}
            </span>
            <a
              class="pager-link"
              href={urlWith({ page: currentPage + 1 })}
              aria-disabled={currentPage === totalPages ? 'true' : undefined}
            >
              Siguiente
            </a>
          </nav>
        )}
      </>
    )
  }
</Admin>

<script>
  // Con JavaScript, cambiar el estado lo guarda directo; sin JavaScript
  // queda el botón "Guardar" de cada fila, que hace lo mismo.
  for (const select of document.querySelectorAll<HTMLSelectElement>(
    '[data-autosubmit]'
  )) {
    select.form?.querySelector<HTMLButtonElement>('.status-apply')?.setAttribute('hidden', '');
    select.addEventListener('change', () => select.form?.submit());
  }
</script>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: flex-start;
    justify-content: space-between;
  }

  .head h1 {
    font-size: var(--text-heading-lg);
  }

  .head-sub {
    margin-top: 4px;
    color: var(--color-neutral-500);
    font-size: var(--text-body-sm);
  }

  .btn-sm {
    min-height: 44px;
    padding: 0 18px;
    font-size: 0.9375rem;
  }

  .tallies {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .tally {
    flex: 1 1 120px;
    background: var(--color-neutral-0);
    border: 1px solid var(--color-neutral-100);
    border-radius: var(--radius-md);
    padding: 14px 16px;
    text-decoration: none;
    color: inherit;
  }

  .tally[aria-current='true'] {
    border-color: var(--color-primary);
    box-shadow: inset 0 0 0 1px var(--color-primary);
  }

  .tally:hover {
    border-color: var(--color-neutral-300);
  }

  .tally-count {
    display: block;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--color-neutral-950);
    line-height: 1;
  }

  .tally-label {
    display: block;
    margin-top: 4px;
    font-size: var(--text-body-sm);
    color: var(--color-neutral-500);
    text-transform: capitalize;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 12px;
    margin-top: 24px;
    background: var(--color-neutral-0);
    border: 1px solid var(--color-neutral-100);
    border-radius: var(--radius-md);
    padding: 20px;
  }

  .filters-field {
    flex: 1 1 180px;
  }

  .filters-clear {
    font-size: var(--text-body-sm);
    color: var(--color-neutral-500);
    padding-block: 12px;
  }

  .empty {
    margin-top: 32px;
    padding: 40px 24px;
    background: var(--color-neutral-0);
    border: 1px dashed var(--color-neutral-300);
    border-radius: var(--radius-md);
    text-align: center;
    color: var(--color-neutral-500);
  }

  .table-wrap {
    margin-top: 24px;
    background: var(--color-neutral-0);
    border: 1px solid var(--color-neutral-100);
    border-radius: var(--radius-md);
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-body-sm);
  }

  th,
  td {
    text-align: left;
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-neutral-100);
    vertical-align: middle;
  }

  th {
    font-family: var(--font-display);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-neutral-500);
    white-space: nowrap;
    background: var(--color-neutral-50);
  }

  tbody tr:last-child td {
    border-bottom: 0;
  }

  tbody tr:hover {
    background: var(--color-neutral-50);
  }

  td a {
    color: var(--color-primary-light);
  }

  .nowrap {
    white-space: nowrap;
  }

  .status-form {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .status-select {
    min-height: 36px;
    padding: 4px 8px;
    border: 1px solid var(--color-neutral-300);
    border-radius: var(--radius-sm);
    background: var(--color-neutral-0);
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    text-transform: capitalize;
  }

  .status-apply {
    min-height: 36px;
    padding: 0 10px;
    border: 1px solid var(--color-neutral-300);
    border-radius: var(--radius-sm);
    background: var(--color-neutral-0);
    font-size: var(--text-body-sm);
    cursor: pointer;
  }

  .pager {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 24px;
    font-size: var(--text-body-sm);
  }

  .pager-link {
    color: var(--color-primary-light);
    padding: 8px 4px;
  }

  .pager-link[aria-disabled='true'] {
    color: var(--color-neutral-300);
    pointer-events: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
