---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Rutas privadas o de paso: fuera del índice de Google. */
  noindex?: boolean;
  /** Solo la home precarga el hero; el resto no tiene imagen crítica. */
  preloadHero?: string;
}

const { title, description, noindex = false, preloadHero } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content="es_AR" />

    {/* Las fuentes son el recurso de texto crítico: sin preload el navegador
        recién las descubre al parsear el CSS, y el texto parpadea. */}
    <link
      rel="preload"
      href="/fonts/barlow-condensed-latin-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {
      preloadHero && (
        <link rel="preload" href={preloadHero} as="image" fetchpriority="high" />
      )
    }

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <slot name="head" />
  </head>

  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <slot />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background: var(--color-primary);
    color: var(--color-neutral-0);
    padding: 12px 20px;
    border-radius: 0 0 var(--radius-sm) 0;
  }

  .skip-link:focus {
    left: 0;
  }
</style>
