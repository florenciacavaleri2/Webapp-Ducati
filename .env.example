# Copiá este archivo como .env y completá los valores.
# .env está en .gitignore: nunca subas credenciales reales al repositorio.

# --- Base de datos ---------------------------------------------------------
#
# Desarrollo local sin crear ninguna cuenta: PGlite, un Postgres embebido que
# guarda todo en la carpeta .data/ del proyecto.
DATABASE_URL="pglite://.data/dev"
#
# Producción: cadena de conexión de Neon.
# (https://console.neon.tech → Connection string). Tiene que incluir sslmode.
# DATABASE_URL="postgresql://usuario:password@ep-algo.region.aws.neon.tech/neondb?sslmode=require"

# --- Panel de administración -----------------------------------------------

# Contraseña única de /admin. Poné una larga y aleatoria.
ADMIN_PASSWORD="cambiame-por-una-contrasena-larga"

# Clave con la que se firma la cookie de sesión del panel.
# Generala con: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET="cambiame-por-una-clave-aleatoria-de-64-caracteres"

# --- Sitio -----------------------------------------------------------------

# URL pública. Se usa para el canonical, el sitemap y los datos estructurados.
PUBLIC_SITE_URL="http://localhost:4321"
